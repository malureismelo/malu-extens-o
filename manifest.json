{
  "manifest_version": 3,
  "name": "Primeira Extensão da Malu",
  "version": "1.0.0",
  "description": "Assistente de prospecção no 99Freelas",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.99freelas.com.br/*",
    "https://api.openai.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
  {
    "matches": ["https://www.99freelas.com.br/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
  ]
}
   
